---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsConfig } from '../lib/data';

type NavItem = {
  label?: string | null;
  href?: string | null;
};

type NavigationDocument = {
  title?: string | null;
  items?: (NavItem | null)[] | null;
};

interface Props {
  config?: CmsConfig | null;
  navigation?: NavigationDocument | null;
}

const { config, navigation } = Astro.props;
const currentYear = new Date().getFullYear();
const seo = config?.seo ?? null;
const siteTitle = seo?.title || 'Digital Growth Society';
const footerLogo = seo?.footerLogo || seo?.logo || '/brand-assets/dgs-homepage/dgs-logo.png';
const footerTagline = seo?.footerTagline || 'Greater together · Since 2019';
const footerCopyrightSuffix = seo?.footerCopyrightSuffix || 'A nonprofit mastermind';
const footerMenuItems = ((navigation?.items ?? []) as NavItem[]).filter((item) => item && item.label && item.href);
---

<footer class="dgs-site-footer" data-brand-footer>
  <div class="dgs-site-footer__inner">
    <div class="dgs-site-footer__brand">
      <img
        src={footerLogo}
        alt={siteTitle}
        width="72"
        height="27"
        data-tina-field={seo ? tinaField(seo, 'footerLogo') : undefined}
        loading="lazy"
        decoding="async"
      />
      <span data-tina-field={seo ? tinaField(seo, 'footerTagline') : undefined}>{footerTagline}</span>
    </div>
    <div class="dgs-site-footer__meta">
      <nav class="dgs-site-footer__links" aria-label={navigation?.title || 'Footer menu'}>
        {footerMenuItems.map((item) => (
          <a href={item.href || '#'} data-tina-field={tinaField(item, 'label')}>{item.label}</a>
        ))}
      </nav>
      <span>&copy; {currentYear} {siteTitle} · <span data-tina-field={seo ? tinaField(seo, 'footerCopyrightSuffix') : undefined}>{footerCopyrightSuffix}</span></span>
    </div>
  </div>
</footer>

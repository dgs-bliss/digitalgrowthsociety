---
import '../styles/dgs-homepage-source.css';

const { data } = Astro.props;
const blocks = Array.isArray(data?.blocks) ? data.blocks : [];
const isHomepageTemplate = (block: any) => block?._template === 'homepageTemplate' || block?.__typename === 'PageBlocksHomepageTemplate';
const homepage = blocks.find(isHomepageTemplate) ?? {};
const sourceContent = homepage?.sourceContent ?? {};

function group(section: string): any {
  return sourceContent?.[section] ?? {};
}
function byKey(items: any, key: string): any {
  return Array.isArray(items) ? items.find((item: any) => item?.key === key) : null;
}
function text(section: string, key: string, fallback: string): string {
  const value = byKey(group(section)?.texts, key)?.value;
  return value === null || value === undefined || value === '' ? fallback : String(value);
}
function asset(section: string, key: string, fallback: string): string {
  const value = byKey(group(section)?.images, key)?.image;
  return value === null || value === undefined || value === '' ? fallback : String(value);
}
function assetAlt(section: string, key: string, fallback: string): string {
  const value = byKey(group(section)?.images, key)?.alt;
  return value === null || value === undefined ? fallback : String(value);
}
function link(section: string, key: string, fallback: string): string {
  const value = byKey(group(section)?.links, key)?.url;
  return value === null || value === undefined || value === '' ? fallback : String(value);
}
